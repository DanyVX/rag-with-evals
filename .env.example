# All providers are disabled by default. Leave keys empty for local/offline development.
RAGX_PROVIDER=mock
RAGX_OPENAI_BASE_URL=
RAGX_OPENAI_API_KEY=
RAGX_ANTHROPIC_API_KEY=
# Hard ceiling across a process. Zero prevents every billable provider call.
RAGX_MAX_PROVIDER_SPEND_USD=0
# Never log source contents, embeddings, API keys, or user queries containing PII.
RAGX_LOG_LEVEL=INFO
RAGX_LOG_JSON=false

