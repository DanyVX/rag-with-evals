# Core runtime
RAGX_ENV=dev
RAGX_CHUNKS_PATH=data/processed/chunks.jsonl
RAGX_INDEX_DIR=data/index
RAGX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAGX_EMBEDDING_CACHE_PATH=cache/embeddings.sqlite3
RAGX_EMBEDDING_PREPROCESS_VERSION=v1
RAGX_RETRIEVER=hybrid
RAGX_RETRIEVE_TOP_N=20
RAGX_TOP_K=5
# RAGX_SCORE_FLOOR=
# RAGX_RERANKER_MODEL=BAAI/bge-reranker-base

# Provider: mock | openai-compatible | anthropic
RAGX_PROVIDER=mock
RAGX_MODEL=mock
RAGX_ALLOW_MOCK_API=false
RAGX_MAX_OUTPUT_TOKENS=2048

# Paid-provider hard budget and explicit current model rates
RAGX_MAX_SPEND_USD=0
RAGX_INPUT_USD_PER_MILLION=0
RAGX_OUTPUT_USD_PER_MILLION=0

# OpenAI-compatible / Ollama
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=
# For local Ollama-compatible use, e.g. http://127.0.0.1:11434/v1.
# Localhost endpoints are treated as zero monetary cost.

# Anthropic
# ANTHROPIC_API_KEY=
